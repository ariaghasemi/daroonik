# Cloudflare Pages reads this file from the published output (it is copied to `out/` by the
# build because it lives in `public/`).

# Hashed build assets (JS/CSS/woff2) never change under the same name → cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: none

# Content images: named files, so no `immutable` — a replaced photo must show up quickly.
/images/*
  Cache-Control: public, max-age=86400

# RSC payloads that Next.js fetches for soft navigations.
/*.txt
  Cache-Control: public, max-age=600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
