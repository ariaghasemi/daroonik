# این فایل اختیاری است.
#
# 1) Cloudflare Pages (و هر هاست استاتیک): هیچ env اجباری نیست.
#    فقط اگر خواستید آدرس canonical / sitemap دقیق باشد، در بخش
#    Pages → Settings → Environment variables این را ست کنید (در زمان بیلد استفاده می‌شود):
#
#    NEXT_PUBLIC_SITE_URL=https://darunik.pages.dev
#
# 2) اجرای با Node + PostgreSQL (npm run build && npm start):
#    DATABASE_URL را ست کنید و بعد جدول‌ها را بسازید: npm run db:push
#
# Local PostgreSQL database used by this demo project:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
