{
  "name": "darunik",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "build:node": "node scripts/build.mjs --node",
    "start": "next start",
    "preview:pages": "npx wrangler pages dev out --ip 0.0.0.0 --port 8788",
    "fonts:build": "node scripts/build-fonts.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.4",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "description": "دارونیک — فروشگاه اینترنتی نمونه سلامت (Next.js 16 + Tailwind v4), قابل میزبانی روی Cloudflare Pages"
